# This is an example file. Copy this to .env and fill in your actual values.

# --- LiveKit Credentials ---
# Get these from your LiveKit Cloud project or self-hosted instance.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Google Cloud & Search Credentials ---
# Get this from your Google Cloud project.
GOOGLE_API_KEY=your_google_api_key

# Get these from your Google Cloud Custom Search Engine setup.
GOOGLE_SEARCH_API_KEY=your_google_search_api_key
SEARCH_ENGINE_ID=your_search_engine_id

# --- OpenWeatherMap API Key ---
# Get this from https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key

# --- Jarvis Configuration ---
# These are optional and have defaults, but you can override them here.

# The user ID for storing conversation history.
USER_ID=default_user

# The name of the creator, mentioned in the prompts.
CREATOR_NAME=Creator

# The name of the assistant.
ASSISTANT_NAME=Jarvis

# Comma-separated list of directories to search for files (e.g., "C:/Users/YourUser/Documents,D:/Media")
SEARCH_DIRECTORIES=D:/

# JSON string for application shortcuts. Use double quotes for keys and strings.
APP_MAPPINGS={"notepad": "notepad", "calculator": "calc"}

# A secret token to activate the keyboard/mouse controller. Change this to a random, secret string.
CONTROLLER_ACTIVATION_TOKEN=change_this_to_a_secret_token
